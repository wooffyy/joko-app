<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_base"
    android:orientation="vertical">

    <!-- Header Navigation -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:paddingHorizontal="16dp">

        <!-- Back Button - Same design as Profile for consistency -->
        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_input_field"
            android:padding="8dp"
            android:src="@drawable/abc_ic_ab_back_material"
            app:tint="@color/white" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:layout_centerHorizontal="true"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/btn_event_bookmark"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingHorizontal="12dp"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:id="@+id/tv_event_bookmark"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:text="Event"
                    android:textColor="@color/white"
                    android:textSize="16sp" />

                <View
                    android:id="@+id/indicator_event_bookmark"
                    android:layout_width="24dp"
                    android:layout_height="2dp"
                    android:layout_marginTop="4dp"
                    android:background="@color/white" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btn_team_bookmark"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingHorizontal="12dp"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:id="@+id/tv_team_bookmark"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="Team"
                    android:textColor="@color/text_secondary"
                    android:textSize="16sp" />

                <View
                    android:id="@+id/indicator_team_bookmark"
                    android:layout_width="24dp"
                    android:layout_height="2dp"
                    android:layout_marginTop="4dp"
                    android:background="@color/white"
                    android:visibility="invisible" />
            </LinearLayout>

        </LinearLayout>

    </RelativeLayout>

    <FrameLayout
        android:id="@+id/fragment_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</LinearLayout>